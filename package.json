{
  "name": "townsquare",
  "version": "2.21.3",
  "description": "Blood on the Clocktower Town Square",
  "author": "Steffen Baumgart",
  "scripts": {
    "clone-images": "rimraf ./tmp/botc-icons/ && git clone https://github.com/tomozbot/botc-icons.git --depth 1 ./tmp/botc-icons",
    "copy-images": "copyfiles -u 3 './tmp/botc-icons/WEBP/**/*' ./src/assets/icons/ && copyfiles -u 3 './tmp/botc-icons/WEBP/*' ./src/assets/icons/",
    "dev": "bun run clone-images && bun run copy-images && vite",
    "build": "bun run clone-images && bun run copy-images && vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "lint-fix": "eslint --ext .js,.vue src --fix"
  },
  "main": "App.vue",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.32",
    "@fortawesome/free-brands-svg-icons": "^5.15.1",
    "@fortawesome/free-solid-svg-icons": "^5.15.1",
    "@fortawesome/vue-fontawesome": "^0.1.10",
    "@vue/runtime-dom": "^3.3.4",
    "prom-client": "^13.0.0",
    "sass": "^1.69.5",
    "sass-loader": "^8.0.2",
    "vue": "^2.7.15",
    "vue-template-compiler": "^2.7.15",
    "vuex": "^3.6.0",
    "ws": "^7.4.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.53.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.1",
    "prettier": "^3.0.3",
    "rimraf": "^6.0.1",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vue2": "^2.0.3"
  },
  "keywords": [
    "botc",
    "townsquare",
    "vue",
    "scss"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com//bra1n/townsquare.git"
  }
}
